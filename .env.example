# Copy to .env for local overrides. Defaults match compose.yaml (development only).
APP_ENV=development

# Database roles (database/init/01_roles.sh). Change all three outside local development.
RAPLM_OWNER_PASSWORD=raplm_owner_dev
RAPLM_READER_PASSWORD=raplm_reader_dev
RAPLM_PUBLISHER_PASSWORD=raplm_publisher_dev
RAPLM_DB_PORT=5433
RAPLM_WEB_PORT=8088

# API (read-only role) when running uvicorn outside Docker
DATABASE_URL=postgresql+psycopg://raplm_reader:raplm_reader_dev@127.0.0.1:5433/raplm
CORS_ORIGINS=["http://localhost:5173","http://localhost:8088"]

# Batch pipeline
RAPLM_DATA_DIR=../RAP-LM-DATA-LOCAL
RAPLM_PUBLISHER_URL=postgresql://raplm_publisher:raplm_publisher_dev@127.0.0.1:5433/raplm
RAPLM_MIGRATION_URL=postgresql+psycopg://raplm_owner:raplm_owner_dev@127.0.0.1:5433/raplm

# Contract tests against PostGIS
RAPLM_TEST_ADMIN_URL=postgresql://raplm_owner:raplm_owner_dev@127.0.0.1:5433/raplm
